generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// Better Auth 认证模型
// ═══════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]
  authorizationCodes AuthorizationCode[] @relation("AuthorizationCodeBoundUser")
  createdAuthorizationCodes AuthorizationCode[] @relation("AuthorizationCodeCreatedBy")

  // 扩展字段：角色
  role          String    @default("user")

  // 扩展字段：生图配额
  imageQuota      Int       @default(9999) @map("image_quota")
  imageQuotaMax   Int       @default(9999) @map("image_quota_max")
  quotaResetAt    DateTime? @map("quota_reset_at")
  quotaResetHours Int       @default(24) @map("quota_reset_hours")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  authorizationCodeId String? @map("authorization_code_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorizationCode AuthorizationCode? @relation(fields: [authorizationCodeId], references: [id], onDelete: SetNull)

  @@map("sessions")
}

model AuthorizationCode {
  id          String   @id @default(cuid())
  code        String   @unique
  status      String   @default("normal")
  note        String?

  quota       Int      @default(50)
  quotaMax    Int      @default(50) @map("quota_max")
  resetHours  Int      @default(24) @map("reset_hours")
  resetAt     DateTime? @map("reset_at")

  userId      String?  @map("user_id")
  createdByAdminId String @map("created_by_admin_id")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User?    @relation("AuthorizationCodeBoundUser", fields: [userId], references: [id], onDelete: SetNull)
  createdByAdmin User  @relation("AuthorizationCodeCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Cascade)
  sessions    Session[]
  tasks       AiImageTask[]
  v2Sessions  AiImageV2Session[]

  @@index([createdByAdminId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("authorization_codes")
}

model Account {
  id                    String  @id @default(cuid())
  userId                String  @map("user_id")
  accountId             String  @map("account_id")
  providerId            String  @map("provider_id")
  accessToken           String? @map("access_token")
  refreshToken          String? @map("refresh_token")
  idToken               String? @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("verifications")
}

// ═══════════════════════════════════════════════════════════════
// 业务模型
// ═══════════════════════════════════════════════════════════════

// 我的模板（用户保存的 Prompt 组合）
model AiPromptGroup {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  userId            String   @map("user_id")
  name              String
  // 用户输入的原始 prompt
  promptContent     String   @map("prompt_content")
  // 最终拼接后的 prompt
  finalPrompt       String?  @map("final_prompt")
  negativePrompt    String?  @map("negative_prompt")
  // 选中的片段 ID 列表（JSON 数组字符串）
  selectedFragmentIds String? @map("selected_fragment_ids")
  configJson        String   @map("config_json")
  remark            String?
  coverImageUrl     String?  @map("cover_image_url")
  useCount          Int      @default(0) @map("use_count")
  lastUsedAt        DateTime? @map("last_used_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  references  AiPromptGroupReference[]
  tasks       AiImageTask[]

  @@map("ai_prompt_groups")
}

// 我的模板关联的参考图
model AiPromptGroupReference {
  id            String   @id @default(cuid())
  groupId       String   @map("group_id")
  imageUrl      String   @map("image_url")
  imageName     String?  @map("image_name")
  sortOrder     Int      @default(0) @map("sort_order")
  referenceType String?  @map("reference_type")
  createdAt     DateTime @default(now()) @map("created_at")

  group AiPromptGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("ai_prompt_group_references")
}

// 生成任务（生成历史）
model AiImageTask {
  id                      String   @id @default(cuid())
  tenantId                String   @map("tenant_id")
  userId                  String   @map("user_id")
  authorizationCodeId     String?  @map("authorization_code_id")
  // 关联的模板 ID（如果是从模板生成的）
  promptGroupId           String?  @map("prompt_group_id")
  // 选中的片段 ID 列表（JSON 数组字符串）
  selectedFragmentIds     String?  @map("selected_fragment_ids")
  // 最终用于生成的 prompt
  promptSnapshot          String   @map("prompt_snapshot")
  // 用户输入的原始 prompt
  userPrompt              String?  @map("user_prompt")
  // 负向 prompt
  negativePromptSnapshot  String?  @map("negative_prompt_snapshot")
  // 生成配置快照
  configSnapshot          String   @map("config_snapshot")
  // 参考图快照
  referenceImagesSnapshot String   @map("reference_images_snapshot")
  status                  String
  resultImageUrl          String?  @map("result_image_url")
  thumbImageUrl           String?  @map("thumb_image_url")
  errorMessage            String?  @map("error_message")
  // 原始 provider 响应（调试用）
  rawResponse             String?  @map("raw_response")
  // 使用的 provider 名称
  provider                String?  @default("mock")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  promptGroup AiPromptGroup? @relation(fields: [promptGroupId], references: [id])
  authorizationCode AuthorizationCode? @relation(fields: [authorizationCodeId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, authorizationCodeId, createdAt(sort: Desc)])
  @@map("ai_image_tasks")
}

// ═══════════════════════════════════════════════════════════════
// V2 工作台数据模型（Session / Plan / GeneratedImage / DetailState）
// ═══════════════════════════════════════════════════════════════

model AiImageV2Session {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  authorizationCodeId String? @map("authorization_code_id")

  // 基础信息
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 工作区标签
  workspaceTab String? @map("workspace_tab")

  // 核心配置
  mode            String   @default("single")
  step            String   @default("input")
  status          String?
  lastError       String?  @map("last_error")

  // 图片配置
  productImageUrls      String? @map("product_image_urls")
  activeProductImageIndex Int    @default(0) @map("active_product_image_index")
  referenceImageUrls    String? @map("reference_image_urls")
  goal                  String  @default("")

  // 输出配置
  outputWidth   Int     @default(1920) @map("output_width")
  outputHeight  Int     @default(1920) @map("output_height")
  provider      String? @default("chatgpt2api")

  // 模板
  selectedTemplateId String? @map("selected_template_id")

  // 单图方案
  expandedSingleId String? @map("expanded_single_id")
  editingSingleId  String? @map("editing_single_id")
  previewPlanId    String? @map("preview_plan_id")
  copiedId         String? @map("copied_id")

  // 生成状态
  generatingImage     Boolean @default(false) @map("generating_image")
  generatingImagePlanId String? @map("generating_image_plan_id")

  // 关联
  plans      AiImageV2Plan[]
  images     AiImageV2GeneratedImage[]
  detail     AiImageV2DetailState?
  authorizationCode AuthorizationCode? @relation(fields: [authorizationCodeId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, updatedAt(sort: Desc)])
  @@index([tenantId, userId, authorizationCodeId, updatedAt(sort: Desc)])
  @@map("ai_image_v2_sessions")
}

model AiImageV2Plan {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")

  // 基础
  planName      String @map("plan_name")
  planArchetype String @map("plan_archetype")
  templateId    String @map("template_id")
  imageType     String @map("image_type")
  sortOrder     Int    @default(0) @map("sort_order")

  // 方向（兼容旧数据）
  layoutDirection String @map("layout_direction")
  visualDirection String @map("visual_direction")
  colorDirection  String @map("color_direction")

  // 视觉呈现（新版：合并版式+色彩方向）
  visualPresentation String? @map("visual_presentation")

  // 文案密度（新增，兼容旧字段）
  copyDensity String? @map("copy_density")

  // 产品分析（JSON）
  productAnalysisJson String? @map("product_analysis_json")

  // 文案（英文，用于图片生成）
  productName  String @map("product_name")
  headline     String? @map("headline")
  subtitle     String?
  sellingPoints String? @map("selling_points") // JSON array
  copyBlocks    String? @map("copy_blocks")    // JSON array

  // 文案（中文，用于前端展示）
  headlineCn     String? @map("headline_cn")
  subtitleCn     String? @map("subtitle_cn")
  sellingPointsCn String? @map("selling_points_cn") // JSON array
  copyBlocksCn    String? @map("copy_blocks_cn")    // JSON array

  copySource String @default("ai_rewritten") @map("copy_source")
  copyNotes  String? @map("copy_notes")        // JSON array

  // 视觉风格
  visualStyleId    String? @map("visual_style_id")
  visualStyleLabel String? @map("visual_style_label")

  // 布局叠加（JSON）
  layoutOverlayJson String? @map("layout_overlay_json")

  // Prompts（超大字段）
  planSummaryPrompt     String? @map("plan_summary_prompt")
  imageGenerationPrompt String? @map("image_generation_prompt")
  finalPrompt           String? @map("final_prompt")

  // 风险
  riskWarnings String? @map("risk_warnings") // JSON array

  createdAt DateTime @default(now()) @map("created_at")

  session AiImageV2Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, sessionId])
  @@map("ai_image_v2_plans")
}

model AiImageV2GeneratedImage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")

  planId      String? @map("plan_id")
  taskId      String? @map("task_id")
  tab         String  @default("product")
  detailType  String? @map("detail_type")
  imageUrl    String  @map("image_url")
  imageBase64 String? @map("image_base64")
  createdAt   DateTime @default(now()) @map("created_at")

  session AiImageV2Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, sessionId])
  @@map("ai_image_v2_generated_images")
}

model AiImageV2DetailState {
  id        String   @id @default(cuid())
  sessionId String   @unique @map("session_id")
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")

  // 参考图
  detailImageUrls      String? @map("detail_image_urls")
  activeDetailImageIndex Int   @default(0) @map("active_detail_image_index")

  // Hero方案（JSON）
  heroPlanJson String? @map("hero_plan_json")

  // 选中的详情图类型
  selectedTypes String? @map("selected_types")

  generating Boolean @default(false)
  lastError  String? @map("last_error")

  // 生成队列与失败状态（用于持久化 DetailRightPanel 生成/失败状态）
  failedTypes          String? @map("failed_types")
  generatingTypes      String? @map("generating_types")
  activeGeneratingType String? @map("active_generating_type")

  createdAt DateTime @default(now()) @map("created_at")

  session AiImageV2Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("ai_image_v2_detail_states")
}
